# Public port exposed by Docker Compose and used by the Node server.
PORT=3001

# Public HTTPS origin used as the dedicated widget domain in MCP Apps metadata.
# Example: https://drawio-mcp.example.com
DOMAIN=

# Optional comma-separated Host header allowlist.
# Example: drawio-mcp.example.com,localhost:3001
ALLOWED_HOSTS=

# Maximum number of stored diagrams.
DIAGRAM_STORE_MAX=200

# Stored diagram lifetime in milliseconds. Default: 7 days.
DIAGRAM_STORE_TTL_MS=604800000

# Node-only optional JSON file path. Docker Compose sets this automatically.
# DIAGRAM_STORE_PATH=/data/diagrams.json
